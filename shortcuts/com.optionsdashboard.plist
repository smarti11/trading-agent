<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.optionsdashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPO_PATH/scripts/start_options_dashboard_background.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>REPO_PATH</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>REPO_PATH/logs/options_dashboard_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>REPO_PATH/logs/options_dashboard_launchd.log</string>
</dict>
</plist>
