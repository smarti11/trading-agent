<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs trend_agent.py at 3:50 PM local time (ET on the Mac mini), Mon-Fri.
  Install:
    cp scripts/com.tradingagent.trendagent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tradingagent.trendagent.plist
  Holidays are skipped automatically (no SPY bar for the day).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tradingagent.trendagent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/minimac/agents/trading-agent/venv/bin/python3</string>
    <string>/Users/minimac/agents/trading-agent/trend_agent.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/minimac/agents/trading-agent</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/minimac/agents/trading-agent/logs/launchd-trend.out</string>
  <key>StandardErrorPath</key><string>/Users/minimac/agents/trading-agent/logs/launchd-trend.err</string>
</dict>
</plist>
